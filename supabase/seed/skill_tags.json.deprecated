[
  {
    "key": "script:latin",
    "family": "script",
    "country": null,
    "meta": {
      "display": "Latin",
      "notes": "Most widely used alphabet. Common in Europe, Americas, parts of Africa and Asia.",
      "examples": ["Hotel", "Restaurant", "Police"]
    }
  },
  {
    "key": "script:devanagari:hindi",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Hindi (Devanagari)",
      "notes": "Most common language in India, found in central and northern regions. Distinctive horizontal line (shirorekha) through the top of each word with straight vertical lines.",
      "examples": ["होटल", "रेस्तरां", "स्कूल"],
      "regions": ["IN-DL", "IN-UP", "IN-MP", "IN-RJ", "IN-HR"]
    }
  },
  {
    "key": "script:devanagari:marathi",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Marathi (Devanagari)",
      "notes": "Found in Maharashtra. Uses Devanagari script but sometimes includes the letter ळ which is not found in Hindi.",
      "examples": ["हॉटेल", "रेस्टॉरंट", "शाळा", "ळ"],
      "regions": ["IN-MH"]
    }
  },
  {
    "key": "script:gurmukhi:punjabi",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Punjabi (Gurmukhi)",
      "notes": "Found in Punjab (northwestern India). Softer letter shapes than Hindi, horizontal bar broken over certain letters. Distinct characters: ਨ, ਲ, ਅ and soft curve diacritic beneath letters.",
      "examples": ["ਹੋਟਲ", "ਰੈਸਟੋਰੈਂਟ", "ਸਕੂਲ", "ਨ", "ਲ", "ਅ"],
      "regions": ["IN-PB"]
    }
  },
  {
    "key": "script:gujarati",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Gujarati",
      "notes": "Found in Gujarat. Similar to Hindi but notably lacks the horizontal line at the top of every word.",
      "examples": ["હોટલ", "રેસ્ટોરન્ટ", "શાળા"],
      "regions": ["IN-GJ"]
    }
  },
  {
    "key": "script:bengali",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Bengali",
      "notes": "Found in northeastern India (West Bengal) and Bangladesh. Similar look to Devanagari but recognizable by many letters featuring left-facing triangular shapes.",
      "examples": ["হোটেল", "রেস্তোরাঁ", "স্কুল"],
      "regions": ["IN-WB", "BD"]
    }
  },
  {
    "key": "script:bengali:assamese",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Assamese (Bengali script)",
      "notes": "Found in Assam. Uses Bengali script with additional characters, most notably ৰ and ৱ.",
      "examples": ["হোটেল", "ৰেস্তোৰাঁ", "স্কুল", "ৰ", "ৱ"],
      "regions": ["IN-AS"]
    }
  },
  {
    "key": "script:kannada",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Kannada",
      "notes": "Found in Karnataka. Smooth curves and small circles. Many characters feature a distinct squiggly tail in the top right corner, less common in Telugu.",
      "examples": ["ಹೋಟೆಲ್", "ರೆಸ್ಟೋರೆಂಟ್", "ಶಾಲೆ"],
      "regions": ["IN-KA"]
    }
  },
  {
    "key": "script:telugu",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Telugu",
      "notes": "Found in Telangana and Andhra Pradesh. Very similar to Kannada but often has diacritics resembling checkmarks at the top of letters.",
      "examples": ["హోటల్", "రెస్టారెంట్", "పాఠశాల"],
      "regions": ["IN-TG", "IN-AP"]
    }
  },
  {
    "key": "script:tamil",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Tamil",
      "notes": "Found in Tamil Nadu (India) and Sri Lanka. Distinct combination of curves, straight lines and 90° angles. Some letters have dot-shaped diacritics.",
      "examples": ["ஹோட்டல்", "உணவகம்", "பள்ளி"],
      "regions": ["IN-TN", "LK"]
    }
  },
  {
    "key": "script:odia",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Odia (Oriya)",
      "notes": "Found in Odisha. Curvy look with many letters having wide semi-circles covering the top. Distinct wide curve diacritic above letters. Resembles a skull emoji shape.",
      "examples": ["ହୋଟେଲ", "ରେଷ୍ଟୁରାଣ୍ଟ", "ବିଦ୍ୟାଳୟ"],
      "regions": ["IN-OR"]
    }
  },
  {
    "key": "script:malayalam",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Malayalam",
      "notes": "Found in Kerala. Somewhat simple-looking curvy letters, often containing upside-down U-shapes.",
      "examples": ["ഹോട്ടല്‍", "റസ്റ്റോറന്റ്", "സ്കൂള്‍"],
      "regions": ["IN-KL"]
    }
  },
  {
    "key": "script:meitei:manipuri",
    "family": "script",
    "country": "IN",
    "meta": {
      "display": "Manipuri (Meitei script)",
      "notes": "Official language of Manipur. Written using Meitei script, recognizable by its many vertical lines and right angles.",
      "examples": ["ꯍꯣꯇꯦꯜ", "ꯔꯦꯁ꯭ꯇꯣꯔꯦꯟꯇ", "ꯁ꯭ꯀꯨꯜ"],
      "regions": ["IN-MN"]
    }
  },
  {
    "key": "script:cyrillic",
    "family": "script",
    "country": "RU",
    "meta": {
      "display": "Cyrillic",
      "notes": "Used in Russia, Ukraine, Bulgaria, Serbia, and other Slavic countries.",
      "examples": ["Гостиница", "Ресторан", "Школа"]
    }
  },
  {
    "key": "script:arabic",
    "family": "script",
    "country": null,
    "meta": {
      "display": "Arabic",
      "notes": "Used in Middle East and North Africa. Written right-to-left, connected cursive style.",
      "examples": ["فندق", "مطعم", "مدرسة"]
    }
  },
  {
    "key": "script:chinese:simplified",
    "family": "script",
    "country": "CN",
    "meta": {
      "display": "Simplified Chinese",
      "notes": "Used in mainland China and Singapore. Simplified form of Chinese characters.",
      "examples": ["酒店", "餐厅", "学校"]
    }
  },
  {
    "key": "script:chinese:traditional",
    "family": "script",
    "country": "TW",
    "meta": {
      "display": "Traditional Chinese",
      "notes": "Used in Taiwan, Hong Kong, and Macau. Traditional form of Chinese characters with more strokes.",
      "examples": ["酒店", "餐廳", "學校"]
    }
  },
  {
    "key": "script:japanese:hiragana",
    "family": "script",
    "country": "JP",
    "meta": {
      "display": "Hiragana",
      "notes": "Japanese syllabary with curved, flowing characters. Used for native Japanese words.",
      "examples": ["ホテル", "レストラン", "がっこう"]
    }
  },
  {
    "key": "script:japanese:katakana",
    "family": "script",
    "country": "JP",
    "meta": {
      "display": "Katakana",
      "notes": "Japanese syllabary with angular characters. Used for foreign words and emphasis.",
      "examples": ["ホテル", "レストラン", "スクール"]
    }
  },
  {
    "key": "script:korean:hangul",
    "family": "script",
    "country": "KR",
    "meta": {
      "display": "Hangul",
      "notes": "Korean alphabet with distinctive circular and linear shapes arranged in syllable blocks.",
      "examples": ["호텔", "레스토랑", "학교"]
    }
  },
  {
    "key": "script:greek",
    "family": "script",
    "country": "GR",
    "meta": {
      "display": "Greek",
      "notes": "Used in Greece and Cyprus. Distinctive letters like Ω, Δ, Π, Σ.",
      "examples": ["Ξενοδοχείο", "Εστιατόριο", "Σχολείο"]
    }
  },
  {
    "key": "script:hebrew",
    "family": "script",
    "country": "IL",
    "meta": {
      "display": "Hebrew",
      "notes": "Used in Israel. Written right-to-left, squared block letters.",
      "examples": ["מלון", "מסעדה", "בית ספר"]
    }
  },
  {
    "key": "script:thai",
    "family": "script",
    "country": "TH",
    "meta": {
      "display": "Thai",
      "notes": "Used in Thailand. Rounded characters with loops and circles, no spaces between words.",
      "examples": ["โรงแรม", "ร้านอาหาร", "โรงเรียน"]
    }
  },
